# Local development settings, read by scripts/dev.ps1, scripts/dev.sh and docker-compose.yml.
# The dev script copies this to .env on first run; edit .env (never committed), not this file.

# Postgres the API and migrator connect to.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=honeywise-dev
POSTGRES_DB=Mead_Tool

# true:  the dev script starts Postgres in Docker (docker-compose.yml) on POSTGRES_PORT.
# false: use a Postgres you already run yourself at the settings above (no Docker needed).
USE_DOCKER_DB=true
