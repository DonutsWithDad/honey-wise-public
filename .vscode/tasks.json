{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/HoneyWise.Api/HoneyWise.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/HoneyWise.Api/HoneyWise.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/HoneyWise.Api/HoneyWise.Api.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "ng serve",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceFolder}/honey-wise-web"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "source": "ts",
                "applyTo": "closedDocuments",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "(Application bundle generation|Building\\.\\.\\.|Watch mode enabled)",
                    "endsPattern": "(Local:\\s+http|watch mode enabled|Application bundle generation complete)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "angular"
            }
        }
    ]
}